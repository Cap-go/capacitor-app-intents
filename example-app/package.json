{
  "name": "capacitor-app-intents-example",
  "version": "1.0.0",
  "description": "Example Capacitor app for @capgo/capacitor-app-intents",
  "type": "module",
  "keywords": [
    "capacitor",
    "mobile"
  ],
  "scripts": {
    "start": "vite",
    "prebuild": "node scripts/example-prebuild.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "generate:ios-app-intents": "node ../scripts/prepare-example-ios.mjs .",
    "generate:shortcuts": "node ../scripts/generate-app-shortcuts.mjs --config app-shortcuts.config.json --output ios-shortcuts/CapgoGeneratedAppShortcuts.swift",
    "generate:typed-intents": "node ../scripts/generate-typed-intents.mjs --config app-intents.codegen.json --output-dir ios-shortcuts/GeneratedAppIntents",
    "generate:skills-bundle": "node ../scripts/generate-skills-bundle.mjs --config app-intents.codegen.json --output ios-shortcuts/Skills.skillsbundle",
    "sync:ios": "bunx cap sync ios && node ../scripts/patch-ios-example-app-intents.mjs ."
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/android": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capgo/capacitor-app-intents": "file:..",
    "@capacitor/splash-screen": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "vite": "^8.3.0",
    "typescript": "^6.0.3"
  },
  "author": "",
  "license": "ISC"
}
